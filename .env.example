# ─── Required ──────────────────────────────────────────────────────────────────
# The agent cannot answer without this. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# At least ONE web-search key is required. Providers without a key are disabled.
# TinyFish is the primary (free search + page fetch with ETag support).
TINYFISH_API_KEY=            # https://agent.tinyfish.ai
EXA_API_KEY=                 # https://dashboard.exa.ai
TAVILY_API_KEY=              # optional 3rd-tier fallback, skipped when empty

# ─── Optional ──────────────────────────────────────────────────────────────────
# Empty = embedded Postgres (PGlite) in ./.data/pglite, zero setup.
# Set to a Neon/Postgres URL to run against a real server with the same schema.
DATABASE_URL=

# Models (cheap by default; any OpenRouter slug works).
# Quality upgrade: MAIN_MODEL=anthropic/claude-sonnet-4.5
MAIN_MODEL=deepseek/deepseek-chat-v3.1
UTILITY_MODEL=google/gemini-2.5-flash-lite
EMBEDDING_MODEL=openai/text-embedding-3-small
JUDGE_MODEL=anthropic/claude-haiku-4.5      # evals only

# ─── Testing / offline ─────────────────────────────────────────────────────────
# ISO timestamp that freezes the agent's clock (demo + evals). Empty = real time.
AGENT_NOW=
# 1 = deterministic offline mode: heuristic planner, template synthesizer,
# fixture-backed search. Used by `npm run eval`; lets the app run with no keys.
MOCK=0
