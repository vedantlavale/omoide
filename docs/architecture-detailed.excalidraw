   "angle": 0,
   "seed": 6775,
   "version": 1,
   "versionNonce": 6782,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "A timestamp alone makes \"what did I ask on 3 November\" a UTC range scan with\ntimezone bugs. Omoide writes the user's CALENDAR DATE (local_date) at insert\ntime, so date questions become indexed equality lookups — and are tried BEFORE\nvectors, because embeddings are unreliable with dates. local_date + turn_id +\nthe claims ledger are the three fields the whole product hangs on.",
   "originalText": "A timestamp alone makes \"what did I ask on 3 November\" a UTC range scan with\ntimezone bugs. Omoide writes the user's CALENDAR DATE (local_date) at insert\ntime, so date questions become indexed equality lookups — and are tried BEFORE\nvectors, because embeddings are unreliable with dates. local_date + turn_id +\nthe claims ledger are the three fields the whole product hangs on.",
   "fontSize": 11.5,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  }
